    - '// @ui {"widget":"group_end"}'
    - "// @ui {\"widget\":\"group_start\", \"label\":\"Voice (optional; a missing clip falls back to Phineas's)\"}"
    - '// @input Asset.AudioTrackAsset P01 {"hint":"Omelet time"}'
