  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Companion Art Set</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @input string companionId = "phineas" {"hint":"Companion id. One of: phineas, hudson, merry, snowy.", "widget":"combobox", "values":[{"label":"phineas", "value":"phineas"}, {"label":"hudson", "value":"hudson"}, {"label":"merry", "value":"merry"}, {"label":"snowy", "value":"snowy"}]}'
    - '// @ui {"widget":"group_start", "label":"Speech bubbles"}'
    - "// @input Asset.Texture bubbleThereItIs {\"hint\":\"'There it is!' bubble, spice shelf (5.5 in wide)\"}"
    - "// @input Asset.Texture bubbleWantSticky {\"hint\":\"'Want me to make a sticky?' bubble (6.8 in wide)\"}"
    - "// @input Asset.Texture bubbleNudge {\"hint\":\"'How's that omelet coming along?' bubble (7.0 in wide)\"}"
