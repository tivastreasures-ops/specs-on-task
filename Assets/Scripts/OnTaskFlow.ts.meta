  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">OnTaskFlow: demo state machine</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input bool showSceneBackgrounds = true {"hint":"Fake-kitchen stand-ins for preview. A live Lens shows the real kitchen through the glasses, so turn this off there."}'
    - '// @input bool includeSampleStickies = true {"hint":"Append the sample stickies after the real saved ones"}'
    - "// @input string[] sampleStickies = {\"Buy Eggs\",\"Water plants\",\"Don't forget sunglasses\",\"Charger cord is in front suitcase pocket\",\"Buy more pet food\"} {\"hint\":\"Editable sample stickies for the browsing views\"}"
    - '// @input string stickyText = "Check out a holiday fair next Saturday, 1 to 5." {"hint":"Text of the proposed sticky"}'
    - '// @input Asset.Texture stickyArt {"hint":"Art for the saved holiday fair sticky on the board (shared, all companions)"}'
    - '// @input Asset.Texture[] sampleStickyArt = {} {"hint":"Sample sticky art for the browsing views (shared). When filled, it replaces the text samples above."}'
    - '// @input float nudgeDelaySeconds = 8 {"hint":"Seconds from Drift until the nudge. A second tap of Drift skips the wait.", "widget":"slider", "min":0, "max":30, "step":0.5}'
    - '// @input float nudgeHoldSeconds = 5 {"hint":"Seconds the nudge bubble stays before fading", "widget":"slider", "min":1, "max":20, "step":0.5}'
    - '// @input float confirmHoldSeconds = 2.5 {"hint":"Seconds the Saved / Remind confirmation stays", "widget":"slider", "min":0.5, "max":10, "step":0.5}'
    - '// @input float fadeSeconds = 0.6 {"hint":"Fade length in seconds", "widget":"slider", "min":0.1, "max":2, "step":0.1}'
    - "// @input float spotDistanceCm = 56 {\"hint\":\"Distance from the user's start to each spot. Spec: 56 cm (22 in). The SPECS 27 preview only shows about 32 cm of width at 56 cm; 66 cm fits the whole 38.1 cm window.\", \"widget\":\"slider\", \"min\":40, \"max\":90, \"step\":1}"
    - '// @input bool previewRotateToActiveSpot {"hint":"Preview convenience, off by default: turns the arc so the active spot faces the camera. Breaks world anchoring, so never use on device."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Spots"}'
    - "// @input SceneObject arcRoot {\"hint\":\"Parent of the five spots. Placed once from the user's start pose.\"}"
    - '// @input AssignableType_1 spotStove {"hint":"Stove spot"}'
    - '// @input AssignableType_2 spotSpiceShelf {"hint":"Spice shelf spot"}'
    - '// @input AssignableType_3 spotFlyerCounter {"hint":"Flyer counter spot"}'
    - '// @input AssignableType_4 spotDishes {"hint":"Dishes spot"}'
    - '// @input AssignableType_5 spotCouch {"hint":"Couch spot"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Per-state visuals"}'
    - "// @input SceneObject bubbleThereItIs {\"hint\":\"'There it is!' bubble\"}"
    - '// @input SceneObject garlicHighlight {"hint":"Frame around the garlic jar"}'
    - "// @input SceneObject bubbleWantSticky {\"hint\":\"'Want me to make a sticky?' bubble\"}"
    - '// @input SceneObject stickyCorner {"hint":"Proposed corner sticky"}'
    - '// @input Component.Text stickyCornerText {"hint":"Corner sticky text"}'
    - '// @input SceneObject bubbleConfirm {"hint":"Saved / Remind confirmation"}'
    - '// @input Component.Text bubbleConfirmText {"hint":"Confirmation text"}'
    - "// @input AssignableType_6 bubbleConfirmFace {\"hint\":\"Confirmation bubble face; switches between the companion's Saved and Saved & Remind art\"}"
    - '// @input SceneObject bubbleNudge {"hint":"Omelet nudge bubble"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Controls"}'
    - '// @input AssignableType_7 yesButton {"hint":"Yes"}'
    - '// @input AssignableType_8 noButton {"hint":"No"}'
    - '// @input AssignableType_9 saveRemindButton {"hint":"Save & Remind"}'
    - '// @input AssignableType_10 saveButton {"hint":"Save"}'
    - '// @input AssignableType_11 dismissButton {"hint":"Dismiss: rejects a proposed sticky"}'
    - '// @input AssignableType_12 myStickiesButton {"hint":"My Stickies: couch idle only"}'
    - '// @input AssignableType_13 board {"hint":"Browsing board"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Demo panel (presenter tool)"}'
    - '// @input SceneObject demoPanel {"hint":"Panel root. Follows the active spot, outside the display window."}'
    - '// @input AssignableType_14 panelGarlic {"hint":"I need garlic"}'
    - '// @input AssignableType_15 panelFlyer {"hint":"Notice flyer"}'
    - '// @input AssignableType_16 panelDrift {"hint":"Drift"}'
